---
import MainLayout from '../layouts/MainLayout.astro';

import Header from '../components/Header';
import Hero from '../components/Hero';
import RegistrationForm from '../components/RegistrationForm';

import Countdown from '../components/Countdown';
import Stats from '../components/Stats';
import FAQ from '../components/FAQ';
import ScrollTop from '../components/ScrollTop';
---

<MainLayout
    title="ClassicCar Experience 2026"
    description="Evento internacional de automóviles clásicos."
>

    <Header />

    <main>

        <Hero
            client:load
            badge="Evento Internacional 2026"
            title="Vive la experiencia de los"
            highlight="Automóviles Clásicos"
            description="Disfruta una exhibición exclusiva con más de 250 vehículos históricos, actividades para toda la familia, concursos de restauración, gastronomía y conferencias."
            image="/images/classic-car.webp"
        />

        <Countdown
            client:load
            targetDate="2026-11-14T09:00:00-06:00"
        />

        <!-- Vehicles -->

        <section
            id="vehiculos"
            class="bg-[var(--color-background)] px-4 py-16 sm:px-6 lg:px-8"
        >

            <div class="mx-auto max-w-6xl">

                <div class="mb-10 text-center">

                    <span class="font-bold uppercase tracking-widest text-[var(--color-primary)]">
                        Vehículos destacados
                    </span>

                    <h2 class="mt-2 text-3xl font-black uppercase sm:text-4xl">
                        Joyas automotrices
                    </h2>

                </div>

                <div class="grid gap-6 md:grid-cols-3">

                    <article class="border-4 border-[var(--color-border)] bg-white shadow-[7px_7px_0_var(--color-border)]">

                        <img
                            src="/images/car1.webp"
                            alt="Ford Mustang 1967"
                            class="h-64 w-full object-cover"
                        />

                        <div class="p-5">

                            <h3 class="text-xl font-black uppercase">
                                Ford Mustang 1967
                            </h3>

                        </div>

                    </article>

                    <article class="border-4 border-[var(--color-border)] bg-white shadow-[7px_7px_0_var(--color-border)]">

                        <img
                            src="/images/car2.webp"
                            alt="Chevrolet Bel Air 1957"
                            class="h-64 w-full object-cover"
                        />

                        <div class="p-5">

                            <h3 class="text-xl font-black uppercase">
                                Chevrolet Bel Air 1957
                            </h3>

                        </div>

                    </article>

                    <article class="border-4 border-[var(--color-border)] bg-white shadow-[7px_7px_0_var(--color-border)]">

                        <img
                            src="/images/car3.webp"
                            alt="Volkswagen Sedán 1963"
                            class="h-64 w-full object-cover"
                        />

                        <div class="p-5">

                            <h3 class="text-xl font-black uppercase">
                                Volkswagen Sedán 1963
                            </h3>

                        </div>

                    </article>

                </div>

            </div>

        </section>

        <!-- Gallery -->

        <section
            id="galeria"
            class="bg-white px-4 py-16 sm:px-6 lg:px-8"
        >

            <div class="mx-auto max-w-6xl">

                <div class="mb-10 text-center">

                    <span class="font-bold uppercase tracking-widest text-[var(--color-primary)]">
                        Galería
                    </span>

                    <h2 class="mt-2 text-3xl font-black uppercase sm:text-4xl">
                        Revive las mejores ediciones
                    </h2>

                </div>

                <div class="grid grid-cols-2 gap-4 md:grid-cols-3">

                    {
                        [
                            'gallery1.webp',
                            'gallery2.webp',
                            'gallery3.webp',
                            'gallery4.webp',
                            'gallery5.webp',
                            'gallery6.webp',
                        ].map((image, index) => (

                            <img
                                src={`/images/${image}`}
                                alt={`Galería ClassicCar Experience ${index + 1}`}
                                class="h-48 w-full border-4 border-[var(--color-border)] object-cover sm:h-64"
                            />

                        ))
                    }

                </div>

            </div>

        </section>

        <!-- Agenda -->

        <section
            id="agenda"
            class="bg-[var(--color-background)] px-4 py-16 sm:px-6 lg:px-8"
        >

            <div class="mx-auto max-w-4xl">

                <div class="mb-10 text-center">

                    <span class="font-bold uppercase tracking-widest text-[var(--color-primary)]">
                        Agenda
                    </span>

                    <h2 class="mt-2 text-3xl font-black uppercase sm:text-4xl">
                        Programa del evento
                    </h2>

                </div>

                <div class="space-y-4">

                    <div class="grid border-4 border-[var(--color-border)] bg-white sm:grid-cols-[150px_1fr]">

                        <strong class="border-b-4 border-[var(--color-border)] bg-[var(--color-primary)] p-5 text-white sm:border-b-0 sm:border-r-4">
                            09:00
                        </strong>

                        <p class="p-5 font-bold">
                            Registro de asistentes
                        </p>

                    </div>

                    <div class="grid border-4 border-[var(--color-border)] bg-white sm:grid-cols-[150px_1fr]">

                        <strong class="border-b-4 border-[var(--color-border)] bg-[var(--color-primary)] p-5 text-white sm:border-b-0 sm:border-r-4">
                            10:00
                        </strong>

                        <p class="p-5 font-bold">
                            Inauguración
                        </p>

                    </div>

                    <div class="grid border-4 border-[var(--color-border)] bg-white sm:grid-cols-[150px_1fr]">

                        <strong class="border-b-4 border-[var(--color-border)] bg-[var(--color-primary)] p-5 text-white sm:border-b-0 sm:border-r-4">
                            11:30
                        </strong>

                        <p class="p-5 font-bold">
                            Exhibición de automóviles
                        </p>

                    </div>

                    <div class="grid border-4 border-[var(--color-border)] bg-white sm:grid-cols-[150px_1fr]">

                        <strong class="border-b-4 border-[var(--color-border)] bg-[var(--color-primary)] p-5 text-white sm:border-b-0 sm:border-r-4">
                            14:00
                        </strong>

                        <p class="p-5 font-bold">
                            Concurso de restauración
                        </p>

                    </div>

                    <div class="grid border-4 border-[var(--color-border)] bg-white sm:grid-cols-[150px_1fr]">

                        <strong class="border-b-4 border-[var(--color-border)] bg-[var(--color-primary)] p-5 text-white sm:border-b-0 sm:border-r-4">
                            17:00
                        </strong>

                        <p class="p-5 font-bold">
                            Premiación
                        </p>

                    </div>

                </div>

            </div>

        </section>        

        <Stats
            client:load
            stats={[
                {
                    label: 'Automóviles',
                    target: 250,
                },
                {
                    label: 'Visitantes',
                    target: 5000,
                    suffix: '+',
                },
                {
                    label: 'Expositores',
                    target: 45,
                },
                {
                    label: 'Años del evento',
                    target: 15,
                },
            ]}
        />

        <!-- Testimonials -->

        <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">

            <div class="mx-auto max-w-6xl">

                <div class="mb-10 text-center">

                    <span class="font-bold uppercase tracking-widest text-[var(--color-primary)]">
                        Testimonios
                    </span>

                    <h2 class="mt-2 text-3xl font-black uppercase sm:text-4xl">
                        Lo que opinan nuestros visitantes
                    </h2>

                </div>

                <div class="grid gap-6 md:grid-cols-2">

                    <article class="border-4 border-[var(--color-border)] bg-[var(--color-background)] p-8 shadow-[7px_7px_0_var(--color-border)]">

                        <p class="text-lg font-bold">
                            "Una experiencia extraordinaria para toda la familia."
                        </p>

                        <h4 class="mt-6 font-black uppercase">
                            — Carlos Mendoza
                        </h4>

                    </article>

                    <article class="border-4 border-[var(--color-border)] bg-[var(--color-background)] p-8 shadow-[7px_7px_0_var(--color-border)]">

                        <p class="text-lg font-bold">
                            "Los mejores vehículos clásicos que he visto en México."
                        </p>

                        <h4 class="mt-6 font-black uppercase">
                            — Laura Hernández
                        </h4>

                    </article>

                </div>

            </div>

        </section>

        <!-- Sponsors -->

        <section class="bg-[var(--color-surface-dark)] px-4 py-16 text-white sm:px-6 lg:px-8">

            <div class="mx-auto max-w-6xl">

                <div class="mb-10 text-center">

                    <span class="font-bold uppercase tracking-widest text-[var(--color-accent)]">
                        Patrocinadores
                    </span>

                    <h2 class="mt-2 text-3xl font-black uppercase sm:text-4xl">
                        Empresas participantes
                    </h2>

                </div>

                <div class="grid grid-cols-2 gap-4 md:grid-cols-5">

                    {
                        [
                            'logo1.webp',
                            'logo2.webp',
                            'logo3.webp',
                            'logo4.webp',
                            'logo5.webp',
                        ].map((logo, index) => (

                            <div class="flex h-32 items-center justify-center border-4 border-white bg-white p-5">

                                <img
                                    src={`/images/${logo}`}
                                    alt={`Patrocinador ${index + 1}`}
                                    class="max-h-20 object-contain"
                                />

                            </div>

                        ))
                    }

                </div>

            </div>

        </section>

        <FAQ
            client:visible
            items={[
                {
                    question: '¿El acceso tiene costo?',
                    answer: 'Sí, el acceso es gratuito con registro previo.',
                },
                {
                    question: '¿Existe estacionamiento?',
                    answer: 'Sí, el recinto cuenta con estacionamiento.',
                },
                {
                    question: '¿Puedo exhibir mi automóvil?',
                    answer: 'Sí, mediante registro previo como expositor.',
                },
            ]}
        />

        <RegistrationForm client:load />

    </main>

    <a
        href="https://wa.me/525537837427"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        class="fixed bottom-6 left-6 z-50 flex h-14 w-14 items-center justify-center border-4 border-[var(--color-border)] bg-[#25D366] text-2xl text-white shadow-[5px_5px_0_var(--color-border)]"
    >
        ☎
    </a>

    <ScrollTop client:load />

    <!-- FOOTER -->

        <footer class="bg-[var(--color-primary-dark)] px-4 py-12 text-white md:px-8">

            <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-center md:justify-between">

                <div>

                    <h2 class="text-2xl font-black uppercase">
                        Classic Car Experience
                    </h2>

                    <p class="mt-2 font-medium">
                        © 2026 Todos los derechos reservados.
                    </p>

                </div>

                <a
                    href="/politicas-privacidad/"
                    class="font-black uppercase underline underline-offset-4"
                >
                    Política de Privacidad
                </a>

            </div>

        </footer>

</MainLayout>