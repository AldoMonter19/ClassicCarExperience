---
import MainLayout from '../layouts/MainLayout.astro';

import Header from '../components/Header';
import Hero from '../components/Hero';
import FeatureCard from '../components/FeatureCard';
import RegistrationForm from '../components/RegistrationForm';
---

<MainLayout
    title="ClassicCar Experience 2026"
    description="Evento internacional de automóviles clásicos."
>

    <Header client:load />

    <main>

        <Hero
            client:load
            badge="Evento Internacional 2026"
            title="Vive la experiencia de los"
            highlight="Automóviles Clásicos"
            description="Disfruta una exhibición exclusiva con más de 250 vehículos históricos, actividades para toda la familia, concursos de restauración, gastronomía y conferencias."
            image="/images/classic-car.webp"
        />

        <!-- EVENTO -->

        <section
            id="evento"
            class="border-b-4 border-[var(--color-border)] bg-white px-4 py-16 md:px-8 md:py-24"
        >

            <div class="mx-auto max-w-7xl">

                <div class="mb-10 max-w-3xl">

                    <span class="font-black uppercase text-[var(--color-primary-light)]">
                        Sobre el evento
                    </span>

                    <h2 class="mt-2 text-4xl font-black uppercase md:text-6xl">
                        Una experiencia inolvidable
                    </h2>

                </div>

                <div class="grid gap-8 md:grid-cols-2">

                    <img
                        src="/images/about.webp"
                        alt="Classic Car Experience"
                        class="w-full border-4 border-[var(--color-border)]"
                    />

                    <div class="flex flex-col justify-center">

                        <p class="text-lg font-medium leading-relaxed">
                            Classic Car Experience reúne a los mejores
                            coleccionistas del país en un evento dedicado
                            a preservar la historia automotriz.
                        </p>

                        <p class="mt-5 text-lg font-medium leading-relaxed">
                            Durante todo el día podrás admirar automóviles
                            perfectamente restaurados, convivir con expertos,
                            participar en concursos y disfrutar actividades
                            para toda la familia.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- FEATURES -->

        <section
            class="border-b-4 border-[var(--color-border)] bg-[var(--color-background)] px-4 py-16 md:px-8 md:py-24"
        >

            <div class="mx-auto max-w-7xl">

                <div class="mb-10">

                    <span class="font-black uppercase text-[var(--color-primary-light)]">
                        ¿Qué encontrarás?
                    </span>

                    <h2 class="mt-2 text-4xl font-black uppercase md:text-6xl">
                        Mucho más que una exhibición
                    </h2>

                </div>

                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                    <FeatureCard
                        title="Vehículos clásicos"
                        description="Más de 250 automóviles restaurados."
                        icon="🚘"
                    />

                    <FeatureCard
                        title="Concurso"
                        description="Premiación al mejor vehículo clásico."
                        icon="🏆"
                    />

                    <FeatureCard
                        title="Música en vivo"
                        description="Bandas durante todo el evento."
                        icon="🎸"
                    />

                    <FeatureCard
                        title="Food Zone"
                        description="Gastronomía para todos los gustos."
                        icon="🍔"
                    />

                </div>

            </div>

        </section>


        <!-- VEHÍCULOS -->

        <section
            id="vehiculos"
            class="border-b-4 border-[var(--color-border)] bg-white px-4 py-16 md:px-8 md:py-24"
        >

            <div class="mx-auto max-w-7xl">

                <span class="font-black uppercase text-[var(--color-primary-light)]">
                    Vehículos destacados
                </span>

                <h2 class="mt-2 text-4xl font-black uppercase md:text-6xl">
                    Joyas automotrices
                </h2>

                <div class="mt-10 grid gap-8 md:grid-cols-3">

                    {[
                        {
                            image: '/images/car1.webp',
                            title: 'Ford Mustang 1967'
                        },
                        {
                            image: '/images/car2.webp',
                            title: 'Chevrolet Bel Air 1957'
                        },
                        {
                            image: '/images/car3.webp',
                            title: 'Volkswagen Sedán 1963'
                        }
                    ].map((car) => (

                        <article class="border-4 border-[var(--color-border)] bg-[var(--color-background)] shadow-[8px_8px_0_var(--color-border)]">

                            <img
                                src={car.image}
                                alt={car.title}
                                class="aspect-video w-full object-cover"
                            />

                            <h3 class="border-t-4 border-[var(--color-border)] p-5 text-xl font-black uppercase">
                                {car.title}
                            </h3>

                        </article>

                    ))}

                </div>

            </div>

        </section>


        <!-- REGISTRO -->

        <section
            id="registro"
            class="border-b-4 border-[var(--color-border)] bg-[var(--color-accent)] px-4 py-16 md:px-8 md:py-24"
        >

            <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2 lg:items-center">

                <div>

                    <span class="font-black uppercase">
                        Registro gratuito
                    </span>

                    <h2 class="mt-3 text-4xl font-black uppercase md:text-6xl">
                        Reserva tu lugar
                    </h2>

                    <p class="mt-5 max-w-xl text-lg font-medium">
                        Regístrate y recibe toda la información
                        relacionada con ClassicCar Experience 2026.
                    </p>

                </div>

                <RegistrationForm client:load />

            </div>

        </section>

    </main>


    <!-- FOOTER -->

    <footer class="bg-[var(--color-primary-dark)] px-4 py-12 text-white md:px-8">

        <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-center md:justify-between">

            <div>

                <h2 class="text-2xl font-black uppercase">
                    ClassicCar Experience
                </h2>

                <p class="mt-2 font-medium">
                    © 2026 Todos los derechos reservados.
                </p>

            </div>

            <a
                href="/politicas-privacidad/"
                class="font-black uppercase underline underline-offset-4"
            >
                Política de Privacidad
            </a>

        </div>

    </footer>

</MainLayout>